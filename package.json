{
  "name": "canvesidian",
  "version": "0.2.0",
  "private": true,
  "description": "Float existing Markdown blocks inside the same Obsidian note",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node qa/build.mjs && node qa/browser-test.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/markdown": "^1.8.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.14.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
